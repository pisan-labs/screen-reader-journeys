{
  // `npm run typecheck`: tsc checks the JavaScript of the hosted service (server/) and the tool
  // (src/) from their JSDoc, without compiling anything. The dashboard (web/) has its own.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["server/**/*.js", "src/**/*.js", "types/**/*.d.ts"]
}
