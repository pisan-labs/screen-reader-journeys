{
  "name": "screen-reader-journeys",
  "version": "0.1.0",
  "private": true,
  "description": "Walk a website the way a keyboard and screen reader user does, and write down what they would hear.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "srj": "./src/cli.js"
  },
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:sql": "bash test/sql/run.sh",
    "srj": "node src/cli.js",
    "start": "node server/index.js",
    "server:dev": "node --env-file-if-exists=.env server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='server/**' --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85 test/*.test.js"
  },
  "dependencies": {
    "@guidepup/guidepup": "0.40.0",
    "@guidepup/virtual-screen-reader": "0.33.0",
    "@supabase/supabase-js": "2.118.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.9.3"
  }
}
