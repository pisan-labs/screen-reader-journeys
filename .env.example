# Every setting the hosted service uses, with no real values. Copy to .env for local development
# (npm run server:dev and cd web && npm run dev read it); never commit .env.
# docs/deploy.md says where each value comes from.

# --- The server (Render) ---------------------------------------------------------------------
# The shared HintWise Supabase project: https://auth.hintwise.org (locally http://127.0.0.1:54321)
SUPABASE_URL=
# The public anon key (claude-built-apps platform/supabase.json): checks people's tokens, acts as
# them, and carries the worker's calls. Never the service-role key: the server refuses to start
# with SUPABASE_SERVICE_ROLE_KEY set.
SUPABASE_ANON_KEY=
# The worker's secret proof to the worker_* functions (openssl rand -base64 32). The database
# keeps only its SHA-256 (supabase/ops/worker-token.sql).
WORKER_TOKEN=
# Origins of the dashboard allowed to call the API, comma-separated:
# https://screen-reader-journeys.hintwise.org
ALLOWED_ORIGINS=
# Sites the server may test, comma-separated: exact hosts, "*." for subdomains, host:port for
# other ports, e.g. stem-accessibility.example.org. Empty allows nothing. Prefer exact hosts:
# *.vercel.app would admit anyone's Vercel deployment. "*" alone admits any public site (http or
# https, ports 80 and 443), for any signed-in person; see docs/deploy.md.
ALLOWED_TARGET_HOSTS=
# Port to listen on (Render sets it; default 8080)
PORT=
# Optional: stop a run after this many seconds (default 900)
RUN_TIMEOUT_SECONDS=
# Optional: seconds between checks for queued runs (default 5)
POLL_INTERVAL_SECONDS=
# Optional: true to run Chromium with its own sandbox, only where the host allows it (default off).
# Required with "*" or a wildcard rule in ALLOWED_TARGET_HOSTS: the worker then starts only if the
# sandbox works here.
CHROMIUM_SANDBOX=
# Optional: seconds before a request to Supabase is given up (default 30)
SUPABASE_TIMEOUT_SECONDS=
# The unprivileged user (number) that runs each run's browser. The Docker image sets both; set
# them only when you start the server as root yourself. RUN_AS_GID defaults to RUN_AS_UID.
RUN_AS_UID=
RUN_AS_GID=

# --- The dashboard (Netlify) -----------------------------------------------------------------
# Built into web/dist/config.js; all of them are public.
# Same as SUPABASE_URL
VITE_SUPABASE_URL=
# Same as SUPABASE_ANON_KEY (never the service-role key; the build refuses it)
VITE_SUPABASE_ANON_KEY=
# The server's URL, e.g. https://screen-reader-journeys.onrender.com (locally http://127.0.0.1:8080)
VITE_API_URL=
# The dashboard's one address (web/src/canonical.ts). Set in netlify.toml for production builds
# only; leave it empty for local work, or a local page would move to the live site.
# VITE_SITE_URL=
